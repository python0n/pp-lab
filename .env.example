# copy to .env and fill in (empty DB_NAME = calculator only, without reworks)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bancho
DB_PASS=
DB_NAME=banchopy
MAPS_DIR=/path/to/bancho.py/.data/osu
# CALC_BIN=/opt/pp-lab/calc/target/release/pp_lab
# MAPS_CACHE_DIR=/opt/pp-lab/cache/osu   (maps downloaded by the calculator)
# RATE_LIMIT_IP_HEADER=X-Real-IP
# CALC_RATE_PER_MINUTE=40
# CALC_CONCURRENCY=2
# MAPS_CACHE_MAX_FILES=5000
# SITE_NAME=pp-lab
# SITE_LOGO=https://example.com/logo.png
# THEME_CSS=themes/example.css
# COVER_URL=https://assets.ppy.sh/beatmaps/{set_id}/covers/cover.jpg
# API_EXTRA_PREFIX=
# RELAX_PP=false        (true = RX button in the calculator, relax pp from akatsuki-pp like bancho.py)
